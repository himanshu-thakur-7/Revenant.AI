# ─────────────────────────────────────────────────────────────
# Revenant.AI — environment template
# Copy to `.env` and fill in. The pipeline runs in OFFLINE mode
# (canned fixtures) when keys are missing, so you can develop the
# whole flow before wiring a single credential.
#
# This file is checked against every real os.getenv()/os.environ[] call
# in the codebase by ghost/tests/test_env_example.py — it fails CI if a
# new env var is added to the code without a line here. See that test's
# docstring for how to regenerate this list.
# ─────────────────────────────────────────────────────────────

# Master switches
REVENANT_MODE=offline          # offline | live   (offline = fixtures, no network)
DRY_RUN=1                      # 1 = never actually send email
STAGE1B_PROVIDER=openai        # openai | cloudflare | offline — the gate's cheap classifier

# Multi-tenancy (agents/tenancy.py). Unset = multi-tenant: the `startup`
# argument on each MCP tool call picks which customer's state is used.
# Set it = this process serves exactly ONE customer, and any tool call
# naming a different startup is REFUSED (not silently redirected).
#
# This is the Phase 4 authorization control. It is an env var on purpose:
# the tool argument travels through an LLM, which can be talked out of an
# instruction, while a value set in the process environment at spawn time
# cannot. Deploy one pinned MCP server per customer to make cross-tenant
# access require compromising the process rather than persuading a model.
# REVENANT_PINNED_TENANT=acme

# Orchestration model (Hermes / Nous Portal, OpenAI, or any OpenAI-compatible endpoint)
# ghost/llm.py's complete()/complete_json() — the deterministic pipeline's copy.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=                # overrides LLM_BASE_URL for OpenAI-specific call sites
                                 # (planner.py, polish.py, tts.py) if set separately

# OpenAI (codegen, copy, embeddings, TTS fallback)
OPENAI_API_KEY=

# "Strong" model route — ghost/llm.py's complete_strong(), used for
# quality-critical steps (research fit-reasoning, outreach email drafting).
# Falls back to LLM_MODEL/LLM_API_KEY if unset.
STRONG_MODEL=
STRONG_MODEL_KEY=
STRONG_MODEL_URL=

# agents/context.py's founder-context summarization model.
BRAIN_MODEL=gpt-5-mini

# The Engineer's own author model (agents/engineer/agent.py).
ENGINEER_MODEL=gpt-4.1
# The planner spec-writer that runs BEFORE the author (agents/engineer/planner.py).
REVENANT_PLANNER_MODEL=gpt-5.6-luna
REVENANT_ENGINEER_PLANNER=1     # 0 disables the planner pass entirely
# Vision QA polish pass (agents/engineer/polish.py) — opt-in, adds ~9s.
REVENANT_POLISH=0
REVENANT_POLISH_MODEL=gpt-4o
# reasoning models only (gpt-5*/o1/o3/o4): minimal|low|medium|high.
# Ignored automatically whenever the call also has tools attached (forced
# to "none" there — see agents/base.py's reasoning_effort/tools guard).
REVENANT_REASONING_EFFORT=

# Apollo (prospect + contact discovery — find_prospects, research-only scans)
APOLLO_API_KEY=

# Linkup (web recon / search). Optional for the demo: if REVENANT_MODE=live
# and this is empty, Revenant uses public Remotive + GitHub recon instead.
LINKUP_API_KEY=

# ElevenLabs (voice memo + walkthrough narration + convo agent). Default
# narration order is OpenAI TTS -> ElevenLabs -> macOS `say`; set
# REVENANT_PREFER_ELEVENLABS=1 to try ElevenLabs first instead.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=              # a voice you own / have consent for
ELEVENLABS_AGENT_ID=              # pre-built conversational agent (the live prototype)
REVENANT_PREFER_ELEVENLABS=0
REVENANT_TTS_MODEL=tts-1          # OpenAI TTS model; tts-1-hd for higher quality (~2-3s slower/beat)
REVENANT_TTS_VOICE=nova           # OpenAI TTS voice
REVENANT_SAY_VOICE=Samantha       # macOS `say` fallback voice (last resort, no network)
REVENANT_SAY_RATE=178             # macOS `say` words-per-minute

# D-ID (avatar lip-sync for the walkthrough presenter — agents/director/avatar.py)
DID_API_KEY=
DID_PRESENTER_ID=
DID_PRESENTER_URL=
DID_AGENT_ID=
DID_AGENT_CLIENT_KEY=
DID_KNOWLEDGE_ID=
DID_POLL_MAX_WAIT=360            # seconds to wait for a render before giving up
DIRECTOR_SKIP_LIPSYNC=0          # 1 = skip D-ID entirely, walkthrough has no presenter overlay
REVENANT_DIRECTOR_LIPSYNC=1      # same switch, read by a second call site — keep both in sync
REVENANT_SKIP_LIPSYNC=0          # a third, older switch for the same behavior — see agents/director

# Cloudflare (Pages Direct Upload — primary prototype/walkthrough hosting;
# local+ngrok is the automatic fallback when these aren't set or CF fails)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=revenant-sites

# Cloudinary (alternate media hosting path — check the actual call site
# before assuming this is load-bearing; grep CLOUDINARY_ if unsure)
CLOUDINARY_API_KEY=
CLOUDINARY_CLOUD_NAME=

# Convex (truth ledger + realtime console — the console/ React app)
CONVEX_URL=
CONVEX_DEPLOY_KEY=
CONVEX_LIVE=1                    # 0 = skip Convex writes even if CONVEX_URL is set
CONVEX_RESET_ON_RUN=1            # 0 = don't wipe the ledger between runs

# Razorpay (test mode — book a paid pilot)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend (transactional email)
RESEND_API_KEY=
FROM_EMAIL=founder@revenant.ai

# Gmail draft creation (agents/sales/gmail_draft.py — OAuth, not an API key)
GOOGLE_OAUTH_CLIENT_JSON=        # path to the downloaded OAuth client secret
GMAIL_TOKEN_PATH=                # where the OAuth token gets cached after `revenant gmail-auth`

# Telegram (the Hermes gateway platform — founder control + HITL alerts;
# NOT the primary product surface, see docs/evals-observability-design.md
# and the console.html/api proxy for that)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_HOME_CHANNEL=

# Founder identity (used in outreach copy, email From: headers, etc.)
FOUNDER_NAME=
FOUNDER_EMAIL=
FOUNDER_COMPANY=

# Demo / delivery routing knobs
REVENANT_DEMO=0                  # 1 = force-arm the deterministic Razorpay stage demo
RAZORPAY_WALKTHROUGH_URL=        # override the pinned boAt stage-demo walkthrough URL
RAZORPAY_DECK_URL=               # override the pinned boAt stage-demo deck URL
REVENANT_FALLBACK_PRESENTER=     # override the pre-rendered Fiona presenter clip used
                                  # when a fresh D-ID render isn't available (0 credits/402)
REVENANT_REPO=                   # overrides the default ~/shroud founder-context source
REVENANT_DELIVER_TARGET=         # explicit "platform:chat_id" override for cron/background delivery
REVENANT_TELEGRAM_TARGET=        # same idea, Telegram-specific fallback
REVENANT_RECORDER_WAIT_UNTIL=    # Playwright wait_until strategy override for screen recording
REVENANT_MCP_LEGACY=0            # 1 = re-expose the deprecated v1 MCP tools (setup_startup, etc.)

# Tracing (ghost/trace.py — see docs/evals-observability-design.md §2)
REVENANT_TRACE=1
REVENANT_TRACE_BACKEND=jsonl     # jsonl (default, no external dependency) | langfuse | none
REVENANT_TRACE_DIR=out/traces
REVENANT_RELEASE=                # defaults to the current git short SHA

# Evals (evals/ — see docs/evals-observability-design.md §1)
EVAL_JUDGE_MODEL=gpt-5.6-sol
EVAL_JUDGE_N=2
EVAL_JUDGE_MAX_ARTIFACT_CHARS=60000   # a real prototype runs 20-36KB; too low
                                       # and the judge never sees the demo section
EVAL_VISION_JUDGE_MODEL=gpt-4o
REVENANT_EVAL_AUTOSCORE=1        # score every production bundle inline after build_full_outreach
REVENANT_EVAL_AUTOFIX=0          # 1 = allow one bounded self-heal retry on a failed eval

# Langfuse (cloud.langfuse.com, free tier) — only used when
# REVENANT_TRACE_BACKEND=langfuse; the jsonl backend needs none of this.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── NOT user-set — read-only context Hermes injects into the process ──
# env when it spawns a run. Listed here only so test_env_example.py's
# coverage check doesn't flag them as "missing"; leave these blank.
# HERMES_SESSION_CHAT_ID=
# HERMES_SESSION_PLATFORM=
# HERMES_SESSION_THREAD_ID=
