# website/ — Vercel project env vars (Settings → Environment Variables in
# the dashboard, or `vercel env add <NAME>`). Copy to .env.local for
# `vercel dev`; never commit the filled-in file — .gitignore already covers
# .env / .env.local at any depth.

# Where the Hermes gateway's api_server is reachable FROM VERCEL — not from
# your laptop. A bare http://127.0.0.1:8642 only works with `vercel dev` run
# on the same machine as the gateway; for the deployed site this needs a
# public URL (tunnel now, the Phase 5 VPS later).
HERMES_BASE=http://127.0.0.1:8642

# The Hermes api_server bearer token — this is API_SERVER_KEY from
# ~/.hermes/.env. Lives ONLY here (server-side); console.html never sees it.
HERMES_API_KEY=

# Comma-separated invite codes. Whoever holds one of these gets in — remove
# a code + redeploy to revoke it instantly (no session store to clean up).
#
# Each entry is `code` or `code:tenant`. The tenant is that code's
# authoritative customer identity, looked up SERVER-SIDE from the signed
# cookie on every request — never read from the request body, because a
# tenant the client can supply is a tenant the client can change. A bare
# `code` maps to the "default" tenant, so an existing single-tenant setup
# keeps working unchanged.
#
#   INVITE_CODES=letmein                        # single-tenant (default)
#   INVITE_CODES=acme-2026:acme,globex-2026:globex   # two customers
#
# Note this makes the CONSOLE tenant-aware; it is defence in depth, not the
# security boundary, since the tenant reaches the tools through an LLM. The
# real enforcement is REVENANT_PINNED_TENANT on the MCP server process (see
# the repo-root .env.example) — one pinned server per customer.
INVITE_CODES=

# Random secret used to HMAC-sign the session cookie issued by /api/auth.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=
